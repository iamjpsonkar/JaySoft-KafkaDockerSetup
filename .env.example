# Kafka Docker Setup Environment Configuration
# Copy this file to .env and modify as needed

# Kafka Configuration
KAFKA_HEAP_OPTS=-Xmx512M -Xms512M
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_BYTES=1073741824
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Zookeeper Configuration  
ZOOKEEPER_AUTOPURGE_PURGE_INTERVAL=24
ZOOKEEPER_AUTOPURGE_SNAP_RETAIN_COUNT=3

# Port Configuration (change if you have conflicts)
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=9093
ZOOKEEPER_PORT=2181
KAFKA_UI_PORT=8080

# Network Configuration
KAFKA_NETWORK_NAME=kafka-net

# Data Persistence
KAFKA_DATA_PATH=./kafka_data
ZOOKEEPER_DATA_PATH=./zookeeper_data
